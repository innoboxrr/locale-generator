{
    "name": "innoboxrr/locale-generator",
    "description": "Generador de traducciónes en formato JSON",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Innoboxrr\\LocaleGenerator\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Homero Raul",
            "email": "h.raulvc@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0 || ^13.0",
        "innoboxrr/larapack-generator": "^9.0"
    },
    "require": {
        "guzzlehttp/guzzle": "^7.7",
        "php": "^8.3",
        "illuminate/support": "^13.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Innoboxrr\\LocaleGenerator\\Providers\\AppServiceProvider",
                "Innoboxrr\\LocaleGenerator\\Providers\\AuthServiceProvider",
                "Innoboxrr\\LocaleGenerator\\Providers\\EventServiceProvider",
                "Innoboxrr\\LocaleGenerator\\Providers\\RouteServiceProvider"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Innoboxrr\\LocaleGenerator\\Tests\\": "tests/"
        }
    }
}
